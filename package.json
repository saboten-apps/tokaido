{
  "name": "tokaido-sugoroku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "vite-node scripts/simulate.ts",
    "check": "npm run lint && npm run test && npm run build",
    "dev:online": "npm run build && wrangler dev --port 8787",
    "test:e2e:online": "playwright test -c playwright.online.config.ts",
    "import:hiroshige": "vite-node scripts/importHiroshige.ts --"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}