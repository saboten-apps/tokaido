{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../src/online/**/*.ts", "../src/engine/**/*.ts", "../src/types/**/*.ts", "../src/events/*.json", "../src/data/*.json"],
  "exclude": ["../src/**/*.test.ts", "../src/online/client.ts"]
}
